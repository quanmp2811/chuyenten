{
  "rules": {
    "current": {
      ".read": true,
      ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
      ".validate": "!newData.exists() || (newData.child('owner').val() === auth.uid && newData.child('url').isString() && newData.child('url').val().length < 2000)"
    }
  }
}
